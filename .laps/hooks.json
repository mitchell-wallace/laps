{
  "version": 1,
  "hooks": [
    {
      "title": "Test on done",
      "description": "Simple test hook.",
      "command": "done",
      "when": "after",
      "run": "echo $@",
      "passback": true
    },
    {
      "title": "Test custom",
      "description": "Simple test script hook.",
      "command": "custom",
      "when": "after",
      "run": ".beads/scripts/test.sh",
      "passback": true
    },
    {
      "title": "Test args",
      "description": "Simple test script hook.",
      "command": "args",
      "when": "after",
      "run": "echo $@",
      "passback": true
    },
    {
      "title": "rally:laps-done",
      "description": "Records lap completion and prompts for wrapup",
      "command": "done",
      "when": "after",
      "run": ".laps/hooks/rally/laps-done-hook.sh \"$id\"",
      "passback": true
    },
    {
      "title": "rally:laps-handoff",
      "description": "Signals handoff state and prompts for wrapup",
      "command": "handoff",
      "when": "before",
      "run": ".laps/hooks/rally/laps-handoff-hook.sh $args",
      "passback": true
    },
    {
      "title": "rally:laps-wrapup",
      "description": "Completes or hands off the current run",
      "command": "wrapup",
      "when": "before",
      "run": ".laps/hooks/rally/laps-wrapup-hook.sh $args",
      "passback": true
    }
  ]
}